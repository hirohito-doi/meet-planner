// Cloudflare Workers の設定(ADR 0005)。秘密の値はここに書かない(リポジトリは公開)。必要になったら wrangler secret put で入れる
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meet-planner",
  // 入口は worker.ts。要求は OpenNext が作る .open-next/worker.js に渡し、Cron Triggers の処理を足している
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // バージョンごとの URL(Version URLs)は使わない。古いバージョンが本番の D1 につながったまま開けてしまい、ログにも残らないため
  "preview_urls": false,
  // 自動削除(docs/spec.md「自動削除」)。毎日 18:00 UTC = 03:00 JST に、古い日程調整を削除する。cron の時刻は UTC
  "triggers": { "crons": ["0 18 * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meet-planner",
      // 本番の D1(Cloudflare の管理画面で作成)。手元の wrangler dev では、この ID でローカルのまねを作る
      "database_id": "ecaa405e-0758-4c5d-bc00-408370bc5f77",
      "migrations_dir": "server/db/migrations"
    }
  ],
  // 回数制限(docs/spec.md「回数制限」)。接続元の IP アドレスごとに、60秒あたりの回数で数える。
  // 数え方はおおよそで、Cloudflare の拠点ごとに数える。namespace_id はアカウントの中で重ならない番号
  "ratelimits": [
    { "name": "CREATE_POLL_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // "off" にすると回数制限をかけない。E2E は短い時間に何十件も作るので、Workers のプレビューでは --var RATE_LIMIT:off で外す
    "RATE_LIMIT": "on"
  }
  // SITE_URL は .env.production に書く(ビルドのときにも要るため。Workers の vars は実行中にしか読めない)
}
