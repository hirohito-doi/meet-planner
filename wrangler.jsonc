// Cloudflare Workers の設定(ADR 0005)。秘密の値はここに書かない(リポジトリは公開)。必要になったら wrangler secret put で入れる
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meet-planner",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // バージョンごとの URL(Version URLs)は使わない。古いバージョンが本番の D1 につながったまま開けてしまい、ログにも残らないため
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meet-planner",
      // 本番の D1(Cloudflare の管理画面で作成)。手元の wrangler dev では、この ID でローカルのまねを作る
      "database_id": "ecaa405e-0758-4c5d-bc00-408370bc5f77",
      "migrations_dir": "server/db/migrations"
    }
  ]
  // SITE_URL は .env.production に書く(ビルドのときにも要るため。Workers の vars は実行中にしか読めない)
}
